# 统一行尾：仓库内文本一律 LF，避免 Windows/Linux 协作时的 diff 噪声
* text=auto eol=lf

# Windows 脚本若日后加入，保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.xlsx binary
*.woff binary
*.woff2 binary
