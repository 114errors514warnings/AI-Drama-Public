# AI Drama 环境变量示例
#
# ⚠️ 本文件仅作示例，程序【不会】自动读取 .env；
#    请在 shell 里 export，或写进 docker compose 的 environment。
# ⚠️ 切勿把真实 API Key 提交到仓库（data/ 与 .env 已在 .gitignore 中）。
#
# 优先级：环境变量 > data/config.json（UI 保存）> 内置默认

# ---- LLM（任意 OpenAI 兼容服务）----
AIDRAMA_API_KEY=sk-your-key-here
AIDRAMA_BASE_URL=https://api.deepseek.com
AIDRAMA_MODEL=deepseek-chat

# 想用其他后端（同样 OpenAI 兼容）：
#   AIDRAMA_BASE_URL=https://api.openai.com/v1
#   AIDRAMA_MODEL=gpt-4o-mini
#   AIDRAMA_BASE_URL=http://127.0.0.1:11434/v1     # 本地 Ollama
#   AIDRAMA_MODEL=qwen2.5:7b

# ---- 运行 ----
# 数据目录（会话 / 角色记忆 / config.json），默认 <项目>/data
AIDRAMA_DATA_DIR=

# 可选：从某个本地文件读取 Key（默认不读）。设为空即禁用。
AIDRAMA_API_KEY_FILE=
