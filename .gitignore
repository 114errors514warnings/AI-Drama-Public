# 启动/停止脚本（按需求不上传）
start.bat
start.ps1
stop.bat
stop.ps1

# 运行时数据（含 API Key、会话记录、角色记忆）
data/

# 环境变量（可能含真实 API Key）
.env
.env.local

# 本地工具产物（Archify 图 / AI 记忆），不随仓库发布
.archify/
.ai-memory/

# 日志
*.log

# 每次回放的运行产物（保留历史样例，不逐次入库）
reports/replay_*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE / 系统
.vscode/
.idea/
.DS_Store
